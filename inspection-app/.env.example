# API Configuration
# Format: http://<IP>:<PORT>  (no trailing slash)
# Example for local network backend:
# EXPO_PUBLIC_API_URL=http://192.168.0.168:8103
EXPO_PUBLIC_API_URL=https://api.reecomm.online


# Environment (development | staging | production)
EXPO_PUBLIC_ENV=development

# App Configuration
EXPO_PUBLIC_APP_NAME=Reecomm Inspector
EXPO_PUBLIC_APP_VERSION=1.0.0
