{
  "expo": {
    "name": "Reecomm Inspector",
    "slug": "reecomm-inspector",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1E56A0"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.reecomm.vehicle.inspector",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1E56A0"
      },
      "package": "com.reecomm.vehicle.inspector",
      "googleServicesFile": "./google-services.json",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Reecomm Inspector to access your photos for vehicle inspections.",
          "cameraPermission": "Allow Reecomm Inspector to use the camera to capture vehicle photos."
        }
      ],
      "expo-video",
      "expo-font",
      "@react-native-firebase/app",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          },
          "android": {
            "enableProguardInRelease": true
          }
        }
      ],
      "react-native-compressor"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d3b2fc3a-438b-48c9-acb3-346be0d816a2"
      }
    }
  }
}
